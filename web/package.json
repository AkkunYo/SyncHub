{
  "name": "synchub-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node -e \"require('node:fs').writeFileSync('node_modules/go.mod', 'module synchub.local/frontend-dependencies\\n\\ngo 1.24.0\\n')\"",
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "type-check": "vue-tsc -b",
    "lint": "eslint ."
  },
  "dependencies": {
    "lucide-vue-next": "^0.536.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.1.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.3.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.4"
  },
  "overrides": {
    "@vue/test-utils": {
      "js-beautify": "2.0.3"
    }
  }
}
